# Copy to .env. Keep the real file out of Git.
NCS_DB_USER=ncs
NCS_DB_PASSWORD=replace-with-a-long-random-password
NCS_DB_NAME=ncs_app
NCS_CHARGER_GATEWAY_TOKEN=replace-with-a-long-random-token

# development enables the simulated SMS code returned by the API. For a public
# deployment use production, set NCS_SMS_MOCK=false and configure the SMS provider.
NCS_ENV=development
NCS_SMS_MOCK=true
NCS_SMS_SENDER_URL=
NCS_SMS_SENDER_TOKEN=

# The mock profile uses the in-compose gateway. For a real gateway set its HTTPS URL
# and start the worker profile instead of the mock profile.
NCS_CHARGER_GATEWAY_URL=http://mock-gateway:8090

NCS_BIND_ADDRESS=127.0.0.1
NCS_USER_PORT=8088
NCS_ADMIN_PORT=8089
NCS_DASHBOARD_PORT=8091

# Images published by .github/workflows/container-images.yml.
NCS_IMAGE_REGISTRY=ghcr.io
NCS_IMAGE_OWNER=cjyhjy
NCS_IMAGE_TAG=retirement

TENCENT_MAP_SERVER_KEY=
TENCENT_MAP_BASE_URL=https://apis.map.qq.com
AI_PROVIDER=openai-compatible
AI_MODEL=
AI_BASE_URL=
AI_API_KEY=
AI_TIMEOUT_MS=15000
