# NCS Go Worker（设备命令与事件消费）
[Unit]
Description=NCS Go Worker (charger commands and events)
After=network-online.target ncs-migrate.service ncs-api.service
Requires=ncs-migrate.service ncs-api.service
Wants=network-online.target

[Service]
Type=simple
User=ncs
Group=ncs
EnvironmentFile=/etc/ncs/backend.env
ExecStart=/usr/local/bin/ncs-worker
Restart=always
RestartSec=2
TimeoutStopSec=30
KillSignal=SIGTERM

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/log/ncs

[Install]
WantedBy=multi-user.target
