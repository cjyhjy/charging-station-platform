# Daily integrity check: checksum plus a readable table of contents for the newest dumps. Without it
# a broken backup is discovered on the day it is needed.
[Unit]
Description=NCS backup integrity check
After=ncs-backup.service

[Service]
Type=oneshot
User=ncs
Group=ncs
EnvironmentFile=/etc/ncs/backend.env
ExecStart=/opt/ncs/backend/scripts/verify-backup.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/backups/ncs
