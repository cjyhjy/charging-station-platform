# Weekly snapshot (kept 12 weeks), so a corruption discovered late is still recoverable after the
# 7-day daily window has rolled over.
[Unit]
Description=NCS PostgreSQL weekly backup
After=postgresql.service ncs-migrate.service

[Service]
Type=oneshot
User=ncs
Group=ncs
EnvironmentFile=/etc/ncs/backend.env
ExecStart=/opt/ncs/backend/scripts/backup-postgres.sh --weekly
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/backups/ncs
