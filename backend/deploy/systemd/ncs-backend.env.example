# NCS Go 后端运行环境（安装到 /etc/ncs/backend.env，chmod 0600，仅 root 与 ncs 可读）
# 这是 Go 后端的变量；仓库根目录 .env.example 是旧 C++/Crow 服务的，不要混用。

# --- 必填 ---
NCS_POSTGRES_DSN=postgres://ncs:CHANGE_ME@127.0.0.1:5432/ncs_dev?sslmode=disable
NCS_REDIS_ADDR=127.0.0.1:6379
# 设备网关服务令牌：无默认值，缺失时 API 拒绝启动；不得下发给 H5。
NCS_CHARGER_GATEWAY_TOKEN=CHANGE_ME

# --- 设备命令与回执 ---
NCS_CHARGER_GATEWAY_URL=http://127.0.0.1:8090
NCS_CHARGER_GATEWAY_TIMEOUT=5s
NCS_CHARGER_EVENT_MAX_FUTURE_SKEW=5m
NCS_STOP_RECOVERY_MAX_ATTEMPTS=3
NCS_STOP_RECOVERY_BACKOFF=5m

# --- 进程 ---
# API 只监听本机：公网入口是 Nginx（B-06 裁决），/metrics 与 /readyz 因此天然不暴露在公网。
NCS_HTTP_ADDR=127.0.0.1:8080
NCS_POSTGRES_MAX_CONNS=10
NCS_OUTBOX_INTERVAL=500ms
NCS_OUTBOX_BATCH=100
NCS_WORKER_CONSUMER=worker-1

# --- 会话与登录 ---
NCS_SESSION_IDLE_TTL=30m
NCS_SESSION_ABSOLUTE_TTL=168h
NCS_LOGIN_RATE_LIMIT=10
NCS_LOGIN_RATE_WINDOW=1m

# --- Nginx 渲染参数（由部署环境读取，供 nginx-render.sh 使用）---
NCS_PUBLIC_HOST=CHANGE_ME.example.com
NCS_HTTP_PORT=80
NCS_HTTPS_PORT=443
NCS_STATIC_ROOT=/srv/h5
NCS_API_UPSTREAM=127.0.0.1:8080
# 证书只传路径，文件由部署环境挂载（不入 Git、不写入本文件）：
#   /etc/ncs/tls/fullchain.pem  0600 root:ncs
#   /etc/ncs/tls/privkey.pem    0600 root:ncs
NCS_TLS_CERT=/etc/ncs/tls/fullchain.pem
NCS_TLS_KEY=/etc/ncs/tls/privkey.pem
# 设备网关来源网段与运维网段：按真实网络规划填写，不要用 0.0.0.0/0。
NCS_GATEWAY_ALLOW=10.20.30.0/24
NCS_OPS_ALLOW=10.99.0.0/16

# --- 运维指标端点（B-06 裁决：只监听本机或内网，禁止公网）---
# 默认 127.0.0.1:9091（Worker）/127.0.0.1:9092（Publisher）/127.0.0.1:9090（API）。
# 留空即用默认值；填非环回/非私网地址会被进程拒绝启动，除非显式设置
# NCS_METRICS_ALLOW_PUBLIC_BIND=true。
NCS_METRICS_ADDR=
NCS_METRICS_ALLOW_PUBLIC_BIND=false

# --- 备份（B-06 裁决：systemd timer，不用 cron）---
# 本机保留 7 天；周备份保留 12 周；异地对象存储保留 30 天（由 push-backup-remote.sh 执行）。
NCS_BACKUP_DIR=/var/backups/ncs/postgres
NCS_BACKUP_RETENTION_DAYS=7
NCS_BACKUP_WEEKLY_RETENTION_WEEKS=12
NCS_BACKUP_WAL_DIR=/var/backups/ncs/wal
# 异地推送凭据单独挂载，权限 0600，不进仓库：
NCS_BACKUP_REMOTE_CONFIG=/etc/ncs/backup-remote.env
# 批准口径（B-06 裁决 ①）：S3 兼容对象存储，远端名固定 ncs-backup-prod，桶 ncs-prod-backup；
# daily/ 保留 30 天、weekly/ 保留 12 周；桶需开启对象版本保护与服务端加密。
NCS_BACKUP_REMOTE=ncs-backup-prod:ncs-prod-backup
NCS_RCLONE_CONFIG=/etc/ncs/rclone/rclone.conf

# --- 环境 ---
# 生产必须是 production，且不得开启模拟短信。
NCS_ENV=production
NCS_SMS_MOCK=false
